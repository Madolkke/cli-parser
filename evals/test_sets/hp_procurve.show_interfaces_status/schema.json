{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "interfaces": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "port": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "status": {
            "type": "string"
          },
          "config_mode": {
            "type": "string"
          },
          "speed": {
            "type": "string"
          },
          "type": {
            "type": "string"
          },
          "tagged": {
            "type": "string"
          },
          "untagged": {
            "type": "string"
          }
        },
        "required": [
          "port",
          "status",
          "tagged",
          "untagged"
        ]
      }
    }
  },
  "required": [
    "interfaces"
  ]
}
