# Copy this file to a private .env file or export the values in the shell.
# The repository does not load .env automatically. For uv, use:
#   uv run --env-file .env python scripts/run_agent_once.py
# Do not commit a populated .env file.

# Required for every live model request. This is an OpenAI-compatible API key.
OPENAI_API_KEY=replace-with-local-key
# Required for every live model request. Model identifier accepted by the provider.
OPENAI_MODEL=replace-with-model-name
# Optional OpenAI-compatible API base URL. Omit for the provider default.
# OPENAI_BASE_URL=https://model.internal.example/v1
# Set to 1/true/yes/on only for a trusted internal HTTPS endpoint with an
# untrusted certificate. The default verifies TLS certificates. This also affects
# the evaluation runner's Laminar SQL HTTP request.
# CLI_PARSER_INSECURE_SKIP_TLS_VERIFY=false

# Optional model request controls. Defaults preserve the library behavior.
# CLI_PARSER_MODEL_STREAM=false
# CLI_PARSER_MODEL_TEMPERATURE=0
# CLI_PARSER_MODEL_PARALLEL_TOOL_CALLS=false
# CLI_PARSER_MODEL_MAX_TOKENS=8192
# CLI_PARSER_MODEL_CONTEXT_SIZE=128000
# CLI_PARSER_MODEL_MAX_RETRIES=2
# CLI_PARSER_MODEL_TIMEOUT_SECONDS=60
# Provider-specific extra_body is intentionally Python-only. Set
# TtpGeneratorSettings(extra_body={...}) when constructing a generator; no
# environment variable or per-request override is provided.

# Optional generation protocol budgets. They apply to every live entry point.
# CLI_PARSER_GENERATION_TIMEOUT_SECONDS=900
# CLI_PARSER_MAX_AGENT_ITERS=13
# CLI_PARSER_MAX_TEMPLATE_SUBMISSIONS=9
# CLI_PARSER_MAX_SCHEMA_NO_TOOL_RETRIES=3
# CLI_PARSER_MAX_TTP_NO_TOOL_RETRIES=3
# CLI_PARSER_TTP_VALIDATION_TIMEOUT_SECONDS=20
# CLI_PARSER_MODEL_INPUT_CHAR_BUDGET=240000

# Optional untrusted-artifact safety limits. Each default is the audited maximum;
# these values may only be reduced, never raised.
# CLI_PARSER_MAX_TTP_TEMPLATE_BYTES=65536
# CLI_PARSER_MAX_TTP_GROUP_DEPTH=16
# CLI_PARSER_MAX_TTP_REGEX_CHARS=2048
# CLI_PARSER_MAX_TTP_ARGUMENT_CHARS=4096
# CLI_PARSER_MAX_PARSE_RESULT_BYTES=8388608
# CLI_PARSER_MAX_SCHEMA_BYTES=65536
# CLI_PARSER_MAX_SCHEMA_DEPTH=16
# CLI_PARSER_MAX_SCHEMA_PROPERTIES=256
# CLI_PARSER_MAX_EVIDENCE_EXCERPT_CHARS=4096

# Optional complete Laminar tracing for normal TtpGenerator usage. Set the key to
# enable tracing. LMNR_BASE_URL and ports are only needed for self-hosted Laminar.
# LMNR_PROJECT_API_KEY=replace-with-local-laminar-key
# LMNR_BASE_URL=https://laminar.internal.example
# LMNR_HTTP_PORT=8000
# LMNR_GRPC_PORT=8001

# run_agent_once.py requires one to five strict UTF-8 output files. Separate paths
# with the host path separator: ';' on Windows and ':' on POSIX systems.
# CLI_PARSER_ONCE_INPUT_FILES=C:\\fixtures\\first.raw;C:\\fixtures\\second.raw
# Optional artifact parent for run_agent_once.py.
# CLI_PARSER_ONCE_ARTIFACT_ROOT=.artifacts/agent-once

# run_agent_tui.py requires one to five strict UTF-8 output files. It always
# enables streaming for this one read-only TUI run, even when MODEL_STREAM=false.
# CLI_PARSER_TUI_INPUT_FILES=C:\\fixtures\\first.raw;C:\\fixtures\\second.raw
# Optional artifact parent for run_agent_tui.py.
# CLI_PARSER_TUI_ARTIFACT_ROOT=.artifacts/agent-tui

# Optional default artifact parent for run_live_corpus.py run. --output-dir and
# --resume still take precedence for an individual invocation.
# CLI_PARSER_LIVE_CORPUS_ARTIFACT_ROOT=.artifacts/live-corpus

# run_agent_evaluation.py run additionally requires all Laminar values below.
# Its list and preflight subcommands do not read environment configuration.
# LMNR_FRONTEND_PORT=5667
# Optional artifact parent and telemetry-ingestion polling limit for evaluations.
# CLI_PARSER_EVAL_ARTIFACT_ROOT=.artifacts/agent-evals
# CLI_PARSER_EVAL_TELEMETRY_WAIT_SECONDS=60
